# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Third-party data snapshots. These change daily and are re-fetchable with
# scripts/fetch_data.py. data/processed/ IS committed on purpose, so a result
# quoted in the dossier can still be checked if the upstream feed changes.
data/raw/
data/external/
!data/raw/.gitkeep

# Firmware
.pio/
.pioenvs/
.piolibdeps/
firmware/**/config_local.h

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets
.env
*.local

# Third-party research snapshots: large, re-fetchable with scripts/acquire.py.
# The manifest, index and findings ARE committed so the research is reproducible.
research/repos/
research/sources/datasets/*
!research/sources/datasets/.gitkeep
