# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Third-party data snapshots. These change daily and are re-fetchable with
# scripts/fetch_data.py. data/processed/ IS committed on purpose, so a result
# quoted in the dossier can still be checked if the upstream feed changes.
data/raw/
data/external/
!data/raw/.gitkeep

# Firmware
.pio/
.pioenvs/
.piolibdeps/
firmware/**/config_local.h

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets
.env
*.local

# Third-party research snapshots: large, re-fetchable with scripts/acquire.py.
# The manifest, index and findings ARE committed so the research is reproducible.
research/repos/
research/sources/datasets/*
!research/sources/datasets/.gitkeep
# Downloaded papers and official reports: ~100 MB, and some are journal
# articles whose redistribution terms are not ours to assume. PROVENANCE.json
# records exactly what was fetched and from where, so the set is reproducible.
research/sources/papers/*
!research/sources/papers/.gitkeep
# IMD gridded rainfall NetCDF grids: ~100 MB for four years, binary, and
# re-fetched in seconds by scripts/acquire.py (acquire_imd_rf25). Same
# reasoning as research/sources/datasets/ above - keep it out of git history.
research/raw/imd_rf25/
# GEFS ensemble GRIB2 slices fetched by scripts/forecast_error_study.py:
# ~450 MB per issue date, binary, re-fetched by the script itself (each
# slice is cached and skipped if already present). The study's OUTPUT
# (data/processed/forecast_error_study_*.json) is committed; this raw cache
# is not, same reasoning as imd_rf25/ above.
research/raw/gefs_hindcast/
